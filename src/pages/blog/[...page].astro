---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostGrid from '../../components/ui/PostGrid.astro';
import Icon from '../../components/ui/Icon.astro';
import { getPosts, type Post } from '../../lib/blog';

/** 12 per page: enough to browse, short enough to scroll. */
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

interface Props { page: Page<Post> }
const { page } = Astro.props;
const onFirstPage = page.currentPage === 1;
---
<BaseLayout
  title={onFirstPage ? 'Small Business Blogging Guides' : `Blog, page ${page.currentPage}`}
  description="Plain-English guides on blogging for a small business: why a blog beats paid ads, how to write posts that bring customers, and how to use Google Search Console."
  noindex={!onFirstPage}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog/' }]}
>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>

  <div class="container-page py-12 lg:py-16">
    <p class="eyebrow">Guides</p>
    <h1 class="mt-5 text-4xl lg:text-5xl">Blog</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Guides for small business owners who want a website, and a blog, that brings in customers.
    </p>
    <div class="mt-10"><PostGrid posts={page.data} /></div>

    {page.lastPage > 1 && (
      <nav aria-label="Pagination" class="mt-14 flex items-center justify-between gap-4 border-t border-hairline pt-8">
        {page.url.prev ? (
          <a href={page.url.prev} class="inline-flex items-center gap-2 font-bold text-brand-700 no-underline hover:text-brand-800">
            <Icon name="arrow-right" size={16} class="rotate-180" /> Newer posts
          </a>
        ) : <span></span>}
        <span class="text-sm text-muted">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="inline-flex items-center gap-2 font-bold text-brand-700 no-underline hover:text-brand-800">
            Older posts <Icon name="arrow-right" size={16} />
          </a>
        ) : <span></span>}
      </nav>
    )}
  </div>
</BaseLayout>
