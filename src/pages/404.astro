---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getPosts } from '../lib/blog';
const recent = (await getPosts()).slice(0, 4);
---
<BaseLayout
  title="Page not found"
  description="That page could not be found. Head back to the homepage, look at the sites we have built, or read the blog for small business owners instead."
  noindex
>
  <div class="container-page py-20 lg:py-28">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-3xl lg:text-4xl">We could not find that page</h1>
    <p class="mt-4 max-w-xl text-lg text-ink-soft">
      The link may be out of date, or the page may have moved. Here is where to go next.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/">Back to home</Button>
      <Button href="/portfolio/" variant="ghost">See our work</Button>
      <Button href="/blog/" variant="ghost">Read the blog</Button>
    </div>

    <h2 class="mt-16 text-xl font-bold">Recent posts</h2>
    <ul class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {recent.map((post) => (
        <li class="border-t border-hairline pt-4">
          <h3 class="text-base font-bold leading-snug">
            <a href={`/${post.id}/`} class="text-ink no-underline hover:text-brand-700">{post.data.title}</a>
          </h3>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
