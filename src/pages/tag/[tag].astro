---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostGrid from '../../components/ui/PostGrid.astro';
import { getPosts, getTags, type Post } from '../../lib/blog';
import { tagLabel } from '../../lib/post-utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)), tag },
  }));
}

interface Props { posts: Post[]; tag: string }
const { posts, tag } = Astro.props;
const label = tagLabel(tag);
---
<BaseLayout
  title={`Posts tagged ${label}`}
  description={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged "${label}" on the Outset Web Design blog: practical guidance for small business owners on websites, blogging and search.`}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: label, url: `/tag/${tag}/` },
  ]}
>
  <div class="container-page py-12 lg:py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="no-underline hover:text-brand-700">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog/" class="no-underline hover:text-brand-700">Blog</a></li>
      </ol>
    </nav>
    <p class="eyebrow">Tag</p>
    <h1 class="mt-2 text-4xl lg:text-5xl">{label}</h1>
    <p class="mt-4 text-lg text-ink-soft">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    <div class="mt-10"><PostGrid posts={posts} /></div>
  </div>
</BaseLayout>
