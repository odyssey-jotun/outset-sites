---
/** Line icons on one 24x24 grid with a single stroke weight. */
export type IconName = 'arrow-right' | 'chevron-right' | 'plus' | 'check' | 'mail' | 'calendar' | 'play';

interface Props { name: IconName; size?: number; class?: string }
const { name, size = 24, class: cls = '' } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  'chevron-right': '<path d="m9 5 7 7-7 7"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6 8.5-6"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  play: '<path d="M7 5v14l11-7z"/>',
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={cls}
  set:html={paths[name]}
/>
