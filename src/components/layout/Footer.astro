---
import { Image } from 'astro:assets';
import { NAV } from '../../lib/nav';
import { LEGAL_NAME, CONTACT_HREF } from '../../lib/site';
import Button from '../ui/Button.astro';
import logo from '../../assets/brand/logo.png';
const year = new Date().getFullYear();
---
<footer class="mt-auto bg-footer text-white">
  <div class="container-page py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1.2fr]">
      <div>
        <a href="/" class="flex items-center gap-3 no-underline" aria-label="Outset Sites, home">
          <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} loading="lazy" class="h-10 w-10 rounded-full bg-white/10 p-0.5" />
          <span class="font-display text-[1.2rem] font-bold tracking-tight text-white">Outset</span>
        </a>
        <p class="mt-5 max-w-sm leading-relaxed text-brand-100">
          Building websites that give small businesses customers, not headaches. Custom builds,
          hosting and maintenance, and SEO strategy and blogging.
        </p>
      </div>
      <nav aria-label="Footer">
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-brand-300">Pages</h2>
        <ul class="mt-5 space-y-3">
          {NAV.map((item) => (
            <li><a href={item.href} class="text-[0.97rem] text-brand-100 no-underline hover:text-white">{item.label}</a></li>
          ))}
          <li><a href="/rss.xml" class="text-[0.97rem] text-brand-100 no-underline hover:text-white">RSS</a></li>
        </ul>
      </nav>
      <div class="rounded-[20px] border border-white/10 bg-white/5 p-6">
        <h2 class="font-display text-xl font-bold text-white">Ready to grow?</h2>
        <p class="mt-2 text-[0.97rem] leading-relaxed text-brand-100">
          Drop us a line and one of us will get back to you within 48 hours.
        </p>
        <Button href={CONTACT_HREF} variant="inverse" class="mt-5">Get in touch</Button>
      </div>
    </div>
    <div class="mt-14 border-t border-white/10 pt-7 text-sm text-brand-200">
      &copy; {year} | {LEGAL_NAME} | All Rights Reserved
    </div>
  </div>
</footer>
