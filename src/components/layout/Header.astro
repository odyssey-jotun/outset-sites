---
import { Image } from 'astro:assets';
import { NAV } from '../../lib/nav';
import { SITE_NAME, CONTACT_HREF } from '../../lib/site';
import MobileNav from '../islands/MobileNav';
import Button from '../ui/Button.astro';
import logo from '../../assets/brand/logo.png';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href.startsWith('/#') ? false : path === href || (href !== '/' && path.startsWith(href));
const links = NAV.filter((item) => item.href !== CONTACT_HREF);
---
<!--
  No backdrop-filter on the header itself: it would make it a containing
  block for position:fixed descendants, which collapses the phone menu panel
  to the height of the header.
-->
<header class="sticky top-0 z-40 border-b border-hairline/80 bg-paper/95" style="--header-h:76px">
  <div class="container-page flex h-[76px] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center gap-3 no-underline" aria-label={`${SITE_NAME}, home`}>
      <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} loading="eager" class="h-10 w-10" />
      <span class="font-display text-[1.2rem] font-bold tracking-tight text-ink">Outset</span>
    </a>

    <nav class="hidden items-center gap-1 rounded-full border border-hairline bg-surface/70 p-1 md:flex" aria-label="Main">
      {links.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-4 py-1.5 text-[0.95rem] font-semibold no-underline transition-colors',
            isActive(item.href) ? 'bg-paper text-ink shadow-[var(--shadow-sm)]' : 'text-ink-soft hover:text-ink',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <Button href={CONTACT_HREF}>Get in touch</Button>
    </div>

    <MobileNav client:media="(max-width: 767px)" nav={NAV} />
  </div>
</header>
