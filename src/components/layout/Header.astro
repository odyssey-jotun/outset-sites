---
import { Image } from 'astro:assets';
import { NAV } from '../../lib/nav';
import { SITE_NAME } from '../../lib/site';
import MobileNav from '../islands/MobileNav';
import logo from '../../assets/brand/logo.png';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href.startsWith('/#') ? false : path === href || (href !== '/' && path.startsWith(href));
---
<!--
  No backdrop-filter here: it would make the header a containing block for
  position:fixed descendants, which collapses the mobile menu panel to the
  height of the header itself.
-->
<header class="sticky top-0 z-40 border-b border-hairline bg-paper" style="--header-h:80px">
  <div class="container-page flex h-[80px] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center gap-3 no-underline" aria-label={`${SITE_NAME}, home`}>
      <Image src={logo} alt="" width={48} height={48} densities={[1, 2]} loading="eager" class="h-12 w-12" />
      <span class="hidden text-lg font-bold tracking-tight text-slate-500 sm:inline">Outset Sites</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'relative rounded-md px-3.5 py-2 text-[1.02rem] font-bold no-underline transition-colors',
            isActive(item.href) ? 'text-brand-600' : 'text-slate-500 hover:text-brand-600',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <MobileNav client:media="(max-width: 767px)" nav={NAV} />
  </div>
</header>
