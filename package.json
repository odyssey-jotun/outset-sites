    "astro": "7.2.7",
    "preact": "10.29.8",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@tailwindcss/vite": "4.3.3",
    "playwright": "^1.62.1",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4",
    "typescript": "^6.0.3",
    "vitest": "4.1.11",
